<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ReverseList — Subcontractors rate the people who hire them" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-slate-50 text-slate-900 min-h-screen">
    <header class="bg-white border-b border-slate-200">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <%= link_to root_path, class: "text-xl font-bold tracking-tight text-slate-900" do %>
          Reverse<span class="text-emerald-600">List</span>
        <% end %>
        <nav class="flex items-center gap-4 text-sm">
          <%= link_to "Developers", users_path(role: "developer"), class: "text-slate-600 hover:text-slate-900" %>
          <%= link_to "Clients", users_path(role: "client"), class: "text-slate-600 hover:text-slate-900" %>
          <%= link_to "Recent reviews", reviews_path, class: "text-slate-600 hover:text-slate-900" %>
          <% if authenticated? %>
            <span class="text-slate-500">Hi, <%= Current.user.display_name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-slate-600 hover:text-slate-900" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "text-slate-600 hover:text-slate-900" %>
            <%= link_to "Sign up", new_registration_path, class: "bg-emerald-600 text-white px-3 py-1.5 rounded-md hover:bg-emerald-700" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <% if notice %><div class="mb-4 rounded-md bg-emerald-50 border border-emerald-200 px-4 py-3 text-emerald-800"><%= notice %></div><% end %>
      <% if alert  %><div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-red-800"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
