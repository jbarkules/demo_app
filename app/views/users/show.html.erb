<% content_for :title, "#{@user.display_name} — ReverseList" %>

<div class="bg-white rounded-lg border border-slate-200 p-6 mb-6">
  <div class="flex items-start justify-between">
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-500"><%= @user.role.capitalize %></p>
      <h1 class="text-2xl font-bold mt-1"><%= @user.display_name %></h1>
      <p class="text-slate-600 mt-1">
        <%= @user.company_name.presence %>
        <% if @user.location.present? %> · <%= @user.location %><% end %>
      </p>
      <% if @user.bio.present? %>
        <p class="text-slate-700 mt-4 whitespace-pre-line"><%= @user.bio %></p>
      <% end %>
    </div>
    <div class="text-right">
      <% if @user.reviews_count > 0 %>
        <p class="text-3xl font-bold text-amber-600">★ <%= @user.average_rating %></p>
        <p class="text-sm text-slate-500"><%= pluralize(@user.reviews_count, "review") %></p>
      <% else %>
        <p class="text-sm text-slate-400">No reviews yet</p>
      <% end %>
    </div>
  </div>

  <% if @user.can_be_reviewed? && Current.user&.can_write_reviews? && Current.user != @user %>
    <div class="mt-5">
      <%= link_to "Write a review", new_user_review_path(@user),
            class: "inline-block bg-emerald-600 text-white px-4 py-2 rounded-md hover:bg-emerald-700" %>
    </div>
  <% elsif @user.can_be_reviewed? && !authenticated? %>
    <p class="mt-5 text-sm text-slate-500">
      <%= link_to "Sign in", new_session_path, class: "text-emerald-700 underline" %> as a subcontractor to leave a review.
    </p>
  <% end %>
</div>

<h2 class="text-xl font-semibold mb-3">Reviews</h2>
<% if @reviews.empty? %>
  <p class="text-slate-500">Be the first to review <%= @user.display_name %>.</p>
<% else %>
  <ul class="space-y-4">
    <% @reviews.each do |review| %>
      <%= render review %>
    <% end %>
  </ul>
<% end %>
